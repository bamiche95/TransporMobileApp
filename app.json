{
  "expo": {
    "name": "RML Transport",
    "slug": "rml-transport",
    "version": "6.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bamiche.RMLTransport"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "./plugins/with-android-built-in-kotlin-compat"
    ],
    "extra": {
      "eas": {
        "projectId": "51bcd3cc-dcd6-4e6d-bfa7-e1bb2abe9b5a"
      }
    }
  }
}
